# BringIt Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Supabase public config (safe to expose in client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Notification worker configuration (server-only, never expose to client)
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notify
NOTIFICATION_CRON_SECRET=replace-with-a-random-secret-min-32-chars